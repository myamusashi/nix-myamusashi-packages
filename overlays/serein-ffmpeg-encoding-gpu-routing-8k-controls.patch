+                                with self.assertRaisesRegex(ValueError, "prefix contains another build"):
+                                    builder.build(args)
+                    for name in ("include/libavcodec/avcodec.h", libraries[0], aliases[0],
+                                 "share/serein-ffmpeg/source/ffmpeg-7.1.5.tar.xz"):
+                        target = prefix / name
