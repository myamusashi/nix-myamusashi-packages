+	fn av1_unit(kind: u8, payload: &[u8], bytes: &mut Vec<u8>) {
+		bytes.push(kind << 3 | 2);
+		let mut size = payload.len();
+		while size >= 128 {
+			bytes.push((size as u8 & 127) | 128);
+			size >>= 7;
+		}
+		bytes.push(size as u8);
+		bytes.extend_from_slice(payload);
+	}
