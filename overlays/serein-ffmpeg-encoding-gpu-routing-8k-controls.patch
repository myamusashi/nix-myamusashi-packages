+  -L"$FFMPEG_DIR/lib" -Wl,-rpath,"$FFMPEG_DIR/lib" \
+  -lavcodec-serein -lavutil-serein -o /tmp/serein-encoder-check
+/tmp/serein-encoder-check /tmp/serein-camera.h264 /tmp/serein-screen.h264
+```
