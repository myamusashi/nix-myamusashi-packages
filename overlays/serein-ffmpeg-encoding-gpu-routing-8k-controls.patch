+		let stop = AtomicBool::new(false);
+		assert_eq!(
+			wait_for_probe(
+				&mut Command::new("/serein-missing-probe-helper"),
+				&stop,
+				Duration::from_secs(1)
+			),
+			UNKNOWN
+		);
+		let mut command = Command::new("/bin/sh");
