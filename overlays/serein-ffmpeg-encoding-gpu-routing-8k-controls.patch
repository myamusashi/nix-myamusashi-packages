+			HardwareSupport {
+				camera: ProbeResult::Unavailable,
+				screen: ProbeResult::Available
+			}
+		);
+		assert_eq!(
+			decode_status(Some(3)),
+			HardwareSupport {
+				camera: ProbeResult::Available,
+				screen: ProbeResult::Available
+			}
+		);
