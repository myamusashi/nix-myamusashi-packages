+// NixOS lists the store outputs used by the system graphics drivers. Mesa can need libraries from several of them.
+static ErrorOr<void> add_nixos_driver_dependency_paths(Vector<PathRule>& paths)
+{
+    auto file = Core::File::open("@NIX_DRIVER_LINK@-closure"sv, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return {};
+
+    auto contents = TRY(file.value()->read_until_eof());
+    for (auto entry : StringView { contents }.lines()) {
+        if (LexicalPath::dirname(entry) != "@NIX_STORE_DIR@"sv)
+            continue;
+
+        auto directory = LexicalPath::join(entry, "lib"sv).string();
+        TRY(add_path_if_exists(paths, directory, PathRule::Access::ReadOnly));
     }
     return {};
 }
